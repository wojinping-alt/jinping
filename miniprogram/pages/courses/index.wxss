.xet-page {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 150rpx;
}

.search-bar {
  margin: 24rpx 26rpx 26rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  color: #9ca3af;
}

.search-icon {
  font-size: 48rpx;
  line-height: 1;
}

.search-text {
  font-size: 40rpx;
  font-weight: 600;
}

.banner-swiper {
  position: relative;
  height: 310rpx;
  overflow: hidden;
  background: #101124;
}

.banner-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dots {
  position: absolute;
  bottom: 20rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
}

.muted-dot {
  background: rgba(255, 255, 255, 0.35);
}

.menu-grid {
  background: #ffffff;
  padding: 38rpx 12rpx 26rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 36rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.menu-icon-img {
  width: 70rpx;
  height: 70rpx;
  display: block;
}

.menu-label {
  margin-top: 12rpx;
  color: #333333;
  font-size: 34rpx;
  font-weight: 500;
}

.state {
  margin: 28rpx 26rpx;
  padding: 36rpx;
  color: #6b7280;
}

.error {
  color: #dc2626;
}

.video-ad-wrap {
  padding: 26rpx 0 0;
  background: #ffffff;
}

.video-ad-scroll {
  width: 100%;
  white-space: nowrap;
}

.video-ad-track {
  display: flex;
  gap: 4rpx;
  padding: 0 26rpx;
}

.video-ad-card {
  position: relative;
  flex: 0 0 600rpx;
  width: 600rpx;
  height: 430rpx;
  overflow: hidden;
  border-radius: 0;
  background: #000000;
}

.video-ad-image {
  width: 100%;
  height: 100%;
  display: block;
}

.video-ad-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.72));
}

.trial-play {
  position: absolute;
  right: 206rpx;
  top: 160rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  text-align: center;
  line-height: 92rpx;
  font-size: 34rpx;
  z-index: 2;
}

.play-triangle {
  margin-left: 36rpx;
  margin-top: 27rpx;
  width: 0;
  height: 0;
  border-left: 24rpx solid #ffffff;
  border-top: 18rpx solid transparent;
  border-bottom: 18rpx solid transparent;
}

.trial-title {
  position: absolute;
  left: 44rpx;
  right: 34rpx;
  bottom: 58rpx;
  z-index: 3;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.25;
}

.trial-dots {
  position: absolute;
  left: 326rpx;
  bottom: 18rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 30rpx;
  letter-spacing: 8rpx;
}

.cover-dark {
  background: #101010;
}

.shop-card {
  margin-top: 26rpx;
  padding: 38rpx 52rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
}

.shop-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  border: 1rpx solid #ececec;
  color: #eab308;
  font-size: 42rpx;
  font-weight: 900;
  text-align: center;
  line-height: 76rpx;
}

.shop-info {
  flex: 1;
  margin-left: 20rpx;
}

.shop-name {
  color: #111111;
  font-size: 40rpx;
  font-weight: 900;
}

.shop-desc {
  margin-top: 6rpx;
  color: #9ca3af;
  font-size: 28rpx;
}

.follow-btn {
  height: 68rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f85f91;
  color: #ffffff;
  line-height: 68rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.section {
  padding: 52rpx 26rpx 0;
  background: #ffffff;
}

.goods-section,
.play-section {
  margin-top: 26rpx;
}

.section-title {
  margin-bottom: 28rpx;
  color: #222222;
  font-size: 48rpx;
  font-weight: 900;
}

.xet-course {
  overflow: hidden;
  margin-bottom: 28rpx;
  border-radius: 14rpx;
  background: #ffffff;
  border: 0;
  box-shadow: none;
}

.course-cover {
  position: relative;
  height: 404rpx;
  overflow: hidden;
  background: #d6d6d6;
}

.course-cover-image {
  width: 100%;
  height: 100%;
  display: block;
}

.course-body {
  padding: 28rpx 28rpx 30rpx;
}

.course-title {
  color: #2e2e2e;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.42;
}

.course-desc {
  margin-top: 18rpx;
  color: #9c9c9c;
  font-size: 32rpx;
  line-height: 1.45;
}

.course-meta {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.course-price {
  color: #999999;
  font-size: 34rpx;
  font-weight: 500;
}

.course-count {
  color: #b5b5b5;
  font-size: 30rpx;
}

.goods-card {
  width: 374rpx;
}

.goods-poster {
  width: 374rpx;
  height: 374rpx;
  border-radius: 14rpx;
  display: block;
}

.goods-info {
  padding-top: 18rpx;
}

.goods-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.4;
}

.goods-desc {
  margin-top: 8rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1.4;
}

.play-poster {
  width: 100%;
  display: block;
}

.service-button {
  position: fixed;
  right: 20rpx;
  bottom: 204rpx;
  z-index: 20;
  width: 136rpx;
  height: 132rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

.service-button::after {
  border: 0;
}

.service-bubble {
  position: fixed;
  right: 48rpx;
  bottom: 246rpx;
  z-index: 20;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 26rpx rgba(0, 0, 0, 0.12);
  color: #333333;
  font-size: 44rpx;
  text-align: center;
  line-height: 86rpx;
}

.service-text {
  position: fixed;
  right: 20rpx;
  bottom: 204rpx;
  z-index: 20;
  color: #666666;
  font-size: 30rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: 132rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5e7eb;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #606060;
}

.tab.active {
  color: #fa5d90;
}

.tab-icon {
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 900;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.follow-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.58);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.follow-modal {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 46rpx 34rpx 38rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-sizing: border-box;
  text-align: center;
}

.follow-close {
  position: absolute;
  right: 24rpx;
  top: 12rpx;
  color: #aaaaaa;
  font-size: 58rpx;
  line-height: 1;
}

.follow-title {
  color: #222222;
  font-size: 38rpx;
  font-weight: 900;
}

.follow-subtitle {
  margin-top: 14rpx;
  color: #777777;
  font-size: 27rpx;
  line-height: 1.45;
}

.follow-qr {
  width: 430rpx;
  height: 430rpx;
  margin-top: 28rpx;
}

.follow-tip {
  margin-top: 18rpx;
  color: #999999;
  font-size: 24rpx;
}

.video-modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 75;
  background: rgba(0, 0, 0, 0.68);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  box-sizing: border-box;
}

.video-modal {
  width: 100%;
  overflow: hidden;
  border-radius: 16rpx;
  background: #111111;
}

.video-modal-head {
  height: 86rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
}

.video-modal-title {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 800;
}

.video-modal-close {
  width: 60rpx;
  height: 60rpx;
  text-align: center;
  line-height: 56rpx;
  color: #ffffff;
  font-size: 54rpx;
}

.video-modal-player {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #000000;
}
