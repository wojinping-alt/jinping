<view class="lesson-page {{unlocked ? 'lesson-page-unlocked' : ''}}">
  <view wx:if="{{loading}}" class="state card">加载中...</view>
  <view wx:elif="{{error}}" class="state card error">{{error}}</view>

  <block wx:else>
    <view class="shop-top">
      <view class="shop-logo" bindtap="goHome">字</view>
      <view class="shop-name" bindtap="goHome">字书</view>
      <view class="shop-spacer"></view>
      <view class="search-mini"></view>
      <view class="user-link">个人中心</view>
    </view>

    <view class="cover-wrap">
      <image class="detail-cover" src="{{course.coverAsset}}" mode="aspectFill"></image>
      <view class="share-chip" bindtap="openPoster">
        <view class="share-icon">♡</view>
        <view>分享</view>
      </view>
      <view class="column-tag">专栏</view>
    </view>

    <view class="detail-main">
      <view class="title-row">
        <view class="title">{{course.displayTitle}}</view>
        <view class="gift" bindtap="openGiftOrder"><view class="gift-icon"></view><text>送好友</text></view>
      </view>
      <view class="meta-line">
        <text>{{unlocked ? "已购买" : "购买后解锁"}}</text>
        <text>{{course.subscriberCount}} 人订阅</text>
      </view>
      <view class="intro-link">商品介绍 ›</view>
    </view>

    <view class="tab-row">
      <view
        class="detail-tab {{activeTab == 'detail' ? 'active' : ''}}"
        bindtap="selectTab"
        data-tab="detail"
      >详情</view>
      <view
        class="detail-tab {{activeTab == 'catalog' ? 'active' : ''}}"
        bindtap="selectTab"
        data-tab="catalog"
      >目录</view>
      <view class="detail-tab disabled">课程互动</view>
    </view>

    <view wx:if="{{activeTab == 'detail'}}" class="intro-card">
      <view class="intro-title">课程介绍</view>
      <view class="intro-text">{{course.description}}</view>
      <image
        wx:for="{{detailImages}}"
        wx:key="*this"
        class="intro-image"
        src="{{item}}"
        mode="widthFix"
        lazy-load="{{true}}"
      ></image>
    </view>

    <view wx:else class="catalog-panel">
      <view class="notice-row">
        <view class="bell"></view>
        <view class="notice-text">开启上新提醒</view>
        <view class="notice-btn">开启</view>
      </view>
      <view class="episode-list">
        <view
          wx:for="{{episodes}}"
          wx:key="id"
          class="episode"
          bindtap="openEpisode"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
        >
          <view class="episode-title">第{{item.episode_number}}集 {{item.title}}</view>
          <view class="episode-meta">视频 {{item.displayDate}} | {{unlocked ? "已学完" : "锁定"}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!unlocked}}" class="buy-bar">
      <view class="buy-price">
        <view class="price">¥ {{course.priceText}}</view>
        <view class="price-note">一次购买，观看本合集全部课程</view>
      </view>
      <button class="buy-button" loading="{{paying}}" bindtap="buyCourse">
        购买合集
      </button>
    </view>

    <view wx:if="{{showPoster}}" class="modal-mask" bindtap="closePoster">
      <view class="poster-panel" catchtap="stopBubble">
        <view class="poster-title">商品海报页</view>
        <view class="poster-image-wrap">
          <image
            wx:if="{{posterImagePath}}"
            class="poster-image"
            src="{{posterImagePath}}"
            mode="widthFix"
            show-menu-by-longpress="{{true}}"
            bindtap="previewPosterImage"
          ></image>
          <view wx:else class="poster-loading">{{posterGenerating ? "海报生成中..." : "海报生成失败"}}</view>
        </view>
        <canvas canvas-id="sharePosterCanvas" class="poster-canvas"></canvas>
        <view class="poster-note">长按上方海报，选择“转发给朋友”即可发送图片</view>
        <view class="poster-actions">
          <view class="poster-action" bindtap="savePosterImage">保存图片</view>
          <view class="poster-action" bindtap="copyShareLink">复制链接</view>
        </view>
      </view>
    </view>

    <view wx:if="{{showGiftOrder}}" class="modal-mask" bindtap="closeGiftOrder">
      <view class="gift-sheet" catchtap="stopBubble">
        <view class="gift-steps">
          <view class="gift-step active"><view class="step-icon bag"></view><text>1. 购买礼物</text></view>
          <view class="gift-step"><view class="step-icon present"></view><text>2. 赠送好友</text></view>
          <view class="gift-step"><view class="step-icon box"></view><text>3. 好友收礼</text></view>
        </view>
        <view class="gift-product">
          <image class="gift-cover" src="{{course.coverAsset}}" mode="aspectFill"></image>
          <view class="gift-info">
            <view class="gift-title">{{course.displayTitle}}</view>
            <view class="gift-price">¥ {{course.priceText}}</view>
          </view>
          <view class="quantity">- <text>1</text> +</view>
        </view>
        <view class="gift-row">
          <view>优惠券/码</view>
          <view class="muted">无可用优惠券 ›</view>
        </view>
        <view class="gift-row">
          <view>留言</view>
          <input class="gift-input" value="{{giftMessage}}" bindinput="onGiftMessageInput" placeholder="选填，建议和好友沟通后再填" />
        </view>
        <view class="gift-submit-bar">
          <view class="gift-total">¥ {{course.priceText}}</view>
          <button class="gift-submit" loading="{{giftPaying}}" bindtap="submitGiftOrder">提交订单</button>
        </view>
      </view>
    </view>

    <view wx:if="{{showGiftShare}}" class="modal-mask" bindtap="closeGiftShare">
      <view class="gift-share-panel" catchtap="stopBubble">
        <view class="gift-share-title">礼物已准备好</view>
        <view class="gift-share-desc">点击下方按钮转发给好友，好友打开后即可领取课程。</view>
        <button class="gift-share-btn" open-type="share" data-share-type="gift">赠送好友</button>
        <view class="gift-share-cancel" bindtap="closeGiftShare">稍后再发</view>
      </view>
    </view>
  </block>
</view>
