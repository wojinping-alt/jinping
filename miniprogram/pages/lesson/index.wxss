.lesson-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f7f7f7;
}

.state {
  margin: 26rpx;
  padding: 40rpx;
  color: #6b7280;
}

.error {
  color: #dc2626;
}

.detail-cover {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #111111;
}

.detail-main {
  padding: 34rpx 32rpx 38rpx;
  background: #ffffff;
}

.course-status {
  color: #c2410c;
  font-size: 26rpx;
  font-weight: 800;
}

.title {
  margin-top: 14rpx;
  color: #252525;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.35;
}

.desc {
  margin-top: 22rpx;
  color: #8b8b8b;
  font-size: 31rpx;
  line-height: 1.55;
}

.meta-line {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  color: #a3a3a3;
  font-size: 30rpx;
}

.tab-row {
  margin-top: 18rpx;
  height: 92rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
}

.detail-tab {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  color: #666666;
  font-size: 32rpx;
  font-weight: 700;
}

.detail-tab.active {
  position: relative;
  color: #f85f91;
}

.detail-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 70rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #f85f91;
  transform: translateX(-50%);
}

.intro-card {
  padding: 34rpx 32rpx;
  background: #ffffff;
}

.intro-title,
.catalog-title {
  color: #252525;
  font-size: 38rpx;
  font-weight: 900;
}

.intro-text {
  margin-top: 18rpx;
  color: #777777;
  font-size: 30rpx;
  line-height: 1.65;
}

.intro-image {
  width: 100%;
  margin-top: 28rpx;
  border-radius: 12rpx;
  display: block;
}

.catalog-title {
  padding: 36rpx 32rpx 18rpx;
  background: #ffffff;
}

.episode-list {
  margin: 0 32rpx 32rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
}

.episode {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 28rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.episode:last-child {
  border-bottom: 0;
}

.episode-no {
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #fff4e6;
  color: #c2410c;
  text-align: center;
  line-height: 58rpx;
  font-size: 25rpx;
  font-weight: 900;
}

.episode-title {
  flex: 1;
  margin-left: 24rpx;
  color: #252525;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.45;
}

.episode-action {
  color: #8b8b8b;
  font-size: 28rpx;
}

.episode-action.playable {
  color: #f06423;
  font-weight: 800;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  min-height: 118rpx;
  padding: 16rpx 28rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.buy-price {
  flex: 1;
  min-width: 0;
}

.price {
  color: #d81b60;
  font-size: 42rpx;
  font-weight: 900;
}

.price-note {
  margin-top: 4rpx;
  color: #888888;
  font-size: 23rpx;
  line-height: 1.35;
}

.buy-button {
  width: 260rpx;
  height: 82rpx;
  margin: 0;
  border: 0;
  border-radius: 12rpx;
  background: #f06423;
  color: #ffffff;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.buy-button::after {
  border: 0;
}

.unlocked {
  width: 220rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #e8f8ee;
  color: #168347;
  text-align: center;
  line-height: 76rpx;
  font-size: 31rpx;
  font-weight: 900;
}
