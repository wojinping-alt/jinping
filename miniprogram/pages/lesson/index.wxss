.lesson-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #f7f7f7;
  color: #222222;
}

.state {
  margin: 26rpx;
  padding: 40rpx;
  color: #6b7280;
}

.error {
  color: #dc2626;
}

.shop-top {
  height: 96rpx;
  padding: 0 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #ededed;
}

.shop-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 1rpx solid #eeeeee;
  color: #d6a400;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 64rpx;
  text-align: center;
}

.shop-name {
  color: #111111;
  font-size: 40rpx;
  font-weight: 900;
}

.shop-spacer {
  flex: 1;
}

.search-mini {
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #222222;
  border-radius: 50%;
  position: relative;
}

.search-mini::after {
  content: "";
  position: absolute;
  right: -16rpx;
  bottom: -12rpx;
  width: 20rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #222222;
  transform: rotate(45deg);
}

.user-link {
  margin-left: 22rpx;
  color: #555555;
  font-size: 38rpx;
}

.cover-wrap {
  position: relative;
  height: 420rpx;
  overflow: hidden;
  background: #111111;
}

.detail-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.share-chip {
  position: absolute;
  right: 0;
  top: 40rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 32rpx 0 0 32rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #4b5563;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.share-icon {
  width: 34rpx;
  height: 34rpx;
  border-radius: 8rpx;
  background: #3b82f6;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
  text-align: center;
}

.column-tag {
  position: absolute;
  right: 14rpx;
  bottom: 14rpx;
  height: 52rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  font-size: 34rpx;
  line-height: 52rpx;
}

.detail-main {
  position: relative;
  padding: 34rpx 32rpx 40rpx;
  background: #ffffff;
}

.title-row {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.title {
  flex: 1;
  color: #111111;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.28;
}

.gift {
  width: 84rpx;
  color: #8a8a8a;
  text-align: center;
}

.gift-icon {
  width: 38rpx;
  height: 34rpx;
  margin: 2rpx auto 0;
  border: 4rpx solid #8a8a8a;
  border-radius: 6rpx;
  position: relative;
}

.gift-icon::before {
  content: "";
  position: absolute;
  left: 13rpx;
  top: -4rpx;
  width: 4rpx;
  height: 38rpx;
  background: #8a8a8a;
}

.gift-icon::after {
  content: "";
  position: absolute;
  left: -4rpx;
  top: 10rpx;
  width: 38rpx;
  height: 4rpx;
  background: #8a8a8a;
}

.gift text {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.15;
}

.meta-line {
  margin-top: 26rpx;
  display: flex;
  justify-content: space-between;
  color: #a0a0a0;
  font-size: 34rpx;
}

.intro-link {
  position: absolute;
  right: 34rpx;
  bottom: 32rpx;
  color: #9a9a9a;
  font-size: 36rpx;
}

.tab-row {
  margin-top: 16rpx;
  height: 104rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #eeeeee;
}

.detail-tab {
  flex: 1;
  height: 104rpx;
  line-height: 104rpx;
  text-align: center;
  color: #8a8a8a;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-tab.active {
  position: relative;
  color: #222222;
  font-size: 48rpx;
  font-weight: 900;
}

.detail-tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 64rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: #2b82e8;
  transform: translateX(-50%);
}

.detail-tab.disabled {
  color: #9b9b9b;
}

.intro-card {
  padding: 36rpx 32rpx 36rpx;
  background: #ffffff;
}

.intro-title {
  color: #222222;
  font-size: 42rpx;
  font-weight: 900;
}

.intro-text {
  margin-top: 24rpx;
  color: #777777;
  font-size: 32rpx;
  line-height: 1.75;
}

.intro-image {
  width: 100%;
  margin-top: 26rpx;
  display: block;
  border-radius: 10rpx;
  background: #ffffff;
}

.catalog-panel {
  background: #ffffff;
  padding: 28rpx 32rpx 38rpx;
}

.notice-row {
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 6rpx;
  background: #fff7ea;
  color: #f59e0b;
  display: flex;
  align-items: center;
}

.bell {
  width: 26rpx;
  height: 30rpx;
  border-radius: 16rpx 16rpx 8rpx 8rpx;
  background: #fbbf24;
}

.notice-text {
  flex: 1;
  text-align: right;
  font-size: 36rpx;
}

.notice-btn {
  margin-left: 18rpx;
  width: 112rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #f59e0b;
  color: #ffffff;
  line-height: 54rpx;
  text-align: center;
  font-size: 32rpx;
}

.episode-list {
  margin-top: 26rpx;
  background: #ffffff;
}

.episode {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.episode-title {
  color: #8f8f8f;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.episode-meta {
  margin-top: 22rpx;
  color: #9c9c9c;
  font-size: 34rpx;
}

.buy-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  min-height: 118rpx;
  padding: 16rpx 28rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.buy-price {
  flex: 1;
  min-width: 0;
}

.price {
  color: #d81b60;
  font-size: 46rpx;
  font-weight: 900;
}

.price-note {
  margin-top: 4rpx;
  color: #888888;
  font-size: 26rpx;
  line-height: 1.35;
}

.buy-button {
  width: 330rpx;
  height: 86rpx;
  margin: 0;
  border: 0;
  border-radius: 12rpx;
  background: #f06423;
  color: #ffffff;
  line-height: 86rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.buy-button::after {
  border: 0;
}

.unlocked {
  width: 260rpx;
  height: 82rpx;
  border-radius: 12rpx;
  background: #f06423;
  color: #ffffff;
  text-align: center;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(0, 0, 0, 0.56);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.poster-panel {
  width: 100%;
  min-height: 82vh;
  border-radius: 28rpx 28rpx 0 0;
  background: #f7f7f7;
  padding: 30rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.poster-title {
  color: #111111;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.poster-image-wrap {
  margin: 24rpx auto 0;
  width: 480rpx;
  min-height: 720rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-image {
  width: 480rpx;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.18);
  display: block;
}

.poster-loading {
  width: 480rpx;
  height: 720rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #888888;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 600px;
  height: 900px;
}

.poster-card {
  margin: 22rpx auto 0;
  width: 480rpx;
  min-height: 720rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #88d7ff 0%, #2aa8f3 100%);
  padding: 18rpx;
  box-sizing: border-box;
}

.poster-window {
  min-height: 684rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 4rpx solid #1f2937;
  overflow: hidden;
}

.poster-top {
  height: 128rpx;
  padding: 24rpx;
  background: #fff28a;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.poster-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #d6a400;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.poster-name {
  color: #111111;
  font-size: 30rpx;
  font-weight: 900;
}

.poster-invite {
  margin-top: 6rpx;
  color: #333333;
  font-size: 24rpx;
}

.poster-cover {
  width: 100%;
  height: 190rpx;
  display: block;
  background: #111111;
}

.poster-course {
  margin: 26rpx 26rpx 0;
  padding: 16rpx;
  background: #ffd3de;
  color: #111111;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.poster-shop {
  margin-top: 26rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 900;
  text-align: center;
}

.poster-qr {
  width: 180rpx;
  height: 180rpx;
  margin: 14rpx auto 0;
  display: block;
}

.poster-tip,
.poster-note {
  color: #333333;
  font-size: 24rpx;
  text-align: center;
}

.poster-note {
  margin-top: 22rpx;
  color: #666666;
  font-size: 34rpx;
}

.poster-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26rpx;
}

.poster-action {
  height: 92rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #666666;
  font-size: 34rpx;
  line-height: 92rpx;
  text-align: center;
}

button.poster-action {
  margin: 0;
  padding: 0;
}

button.poster-action::after {
  border: 0;
}

.gift-sheet {
  width: 100%;
  min-height: 78vh;
  background: #f4f4f4;
  padding-bottom: calc(126rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.gift-steps {
  height: 164rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.gift-step {
  flex: 1;
  min-width: 220rpx;
  color: #9a9a9a;
  font-size: 32rpx;
  text-align: center;
}

.gift-step.active {
  color: #173047;
}

.step-icon {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 10rpx;
  border-radius: 8rpx;
  background: #87a9c6;
}

.gift-step.active .step-icon {
  background: #0f65a7;
}

.gift-product {
  margin-top: 18rpx;
  min-height: 190rpx;
  padding: 26rpx 22rpx;
  background: #ffffff;
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
}

.gift-cover {
  width: 166rpx;
  height: 144rpx;
  border-radius: 8rpx;
  background: #eeeeee;
}

.gift-info {
  flex: 1;
  min-width: 0;
}

.gift-title {
  color: #333333;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
}

.gift-price {
  margin-top: 20rpx;
  color: #f06423;
  font-size: 34rpx;
}

.quantity {
  width: 150rpx;
  align-self: flex-end;
  color: #111111;
  font-size: 32rpx;
  display: flex;
  justify-content: space-between;
}

.quantity text {
  min-width: 52rpx;
  height: 44rpx;
  background: #f4f4f4;
  text-align: center;
  line-height: 44rpx;
}

.gift-row {
  margin-top: 16rpx;
  height: 100rpx;
  padding: 0 22rpx;
  background: #ffffff;
  color: #333333;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #c4c4c4;
}

.gift-input {
  flex: 1;
  margin-left: 32rpx;
  color: #333333;
  text-align: right;
}

.gift-submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  height: 118rpx;
  padding: 0 42rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gift-total {
  color: #f06423;
  font-size: 52rpx;
  font-weight: 900;
}

.gift-submit {
  width: 268rpx;
  height: 78rpx;
  margin: 0;
  border-radius: 16rpx;
  background: #075a9e;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 78rpx;
}

.gift-submit::after {
  border: 0;
}

.gift-share-panel {
  width: 620rpx;
  margin-bottom: 20vh;
  padding: 48rpx 36rpx;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.gift-share-title {
  color: #111111;
  font-size: 42rpx;
  font-weight: 900;
}

.gift-share-desc {
  margin-top: 22rpx;
  color: #777777;
  font-size: 30rpx;
  line-height: 1.6;
}

.gift-share-btn {
  height: 86rpx;
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: #f85f91;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 86rpx;
}

.gift-share-btn::after {
  border: 0;
}

.gift-share-cancel {
  margin-top: 26rpx;
  color: #999999;
  font-size: 30rpx;
}
