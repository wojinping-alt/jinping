.mine-page {
  min-height: 100vh;
  padding: 40rpx 20rpx 150rpx;
  background: linear-gradient(180deg, #fff8f2 0%, #ffffff 220rpx, #f7f7f7 221rpx);
  box-sizing: border-box;
  color: #333333;
}

.profile {
  height: 146rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-button {
  width: 112rpx;
  height: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  overflow: hidden;
}

.avatar-button::after {
  border: 0;
}

.avatar-image,
.avatar-fallback {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
  color: #d2a600;
  font-size: 54rpx;
  font-weight: 900;
}

.profile-name {
  color: #2d2d2d;
  font-size: 52rpx;
  font-weight: 900;
}

.refresh-icon {
  width: 36rpx;
  height: 36rpx;
  border: 5rpx solid #a3a3a3;
  border-left-color: transparent;
  border-radius: 50%;
}

.profile-spacer {
  flex: 1;
}

.header-icon {
  width: 52rpx;
  height: 52rpx;
  position: relative;
  color: #9b9b9b;
}

.gear::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 9rpx;
  width: 26rpx;
  height: 26rpx;
  border: 6rpx solid currentColor;
  border-radius: 50%;
  box-shadow: 0 -12rpx 0 -7rpx currentColor, 0 12rpx 0 -7rpx currentColor,
    12rpx 0 0 -7rpx currentColor, -12rpx 0 0 -7rpx currentColor,
    9rpx 9rpx 0 -8rpx currentColor, -9rpx -9rpx 0 -8rpx currentColor,
    9rpx -9rpx 0 -8rpx currentColor, -9rpx 9rpx 0 -8rpx currentColor;
}

.message::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 10rpx;
  width: 36rpx;
  height: 28rpx;
  border: 5rpx solid currentColor;
  border-radius: 10rpx;
}

.message::after {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 35rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 5rpx solid currentColor;
  border-bottom: 5rpx solid currentColor;
  transform: skewX(-25deg);
}

.stats-card,
.center-row,
.panel {
  border-radius: 14rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
}

.stats-card {
  height: 184rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.stat-item {
  text-align: center;
}

.stat-number {
  color: #333333;
  font-size: 56rpx;
  font-weight: 900;
}

.money {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.stat-label {
  margin-top: 14rpx;
  color: #666666;
  font-size: 31rpx;
}

.center-row {
  height: 92rpx;
  margin-top: 22rpx;
  padding: 0 26rpx;
  display: flex;
  align-items: center;
}

.book-line {
  width: 30rpx;
  height: 36rpx;
  border: 4rpx solid #444444;
  border-radius: 4rpx;
  border-right-color: #f85f91;
}

.center-text {
  flex: 1;
  margin-left: 20rpx;
  color: #3b3b3b;
  font-size: 34rpx;
}

.center-text text {
  color: #f85f91;
  font-size: 42rpx;
}

.arrow,
.panel-link {
  color: #c4c4c4;
  font-size: 40rpx;
}

.panel {
  margin-top: 22rpx;
  padding: 34rpx 24rpx 48rpx;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title,
.tool-title {
  color: #333333;
  font-size: 40rpx;
  font-weight: 900;
}

.panel-link {
  font-size: 32rpx;
}

.order-grid {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
}

.order-item,
.tool-item {
  position: relative;
  text-align: center;
  color: #555555;
}

.order-icon {
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 14rpx;
  position: relative;
  border: 5rpx solid #333333;
  border-radius: 8rpx;
}

.wallet::after {
  content: "";
  position: absolute;
  right: 6rpx;
  top: 20rpx;
  width: 18rpx;
  height: 12rpx;
  border: 4rpx solid #333333;
  border-radius: 999rpx;
}

.box::after {
  content: "";
  position: absolute;
  left: 16rpx;
  top: -5rpx;
  width: 18rpx;
  height: 20rpx;
  border: 5rpx solid #333333;
  border-top: 0;
  border-radius: 0 0 6rpx 6rpx;
  background: #ffffff;
}

.truck {
  border-left: 0;
  border-top-left-radius: 0;
}

.truck::before {
  content: "";
  position: absolute;
  left: -22rpx;
  bottom: -5rpx;
  width: 22rpx;
  height: 30rpx;
  border: 5rpx solid #333333;
  border-right: 0;
}

.chat {
  border-radius: 12rpx;
}

.chat::after {
  content: "";
  position: absolute;
  left: 13rpx;
  top: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #333333;
  box-shadow: 16rpx 0 0 #333333;
}

.refund::after {
  content: "¥";
  position: absolute;
  left: 14rpx;
  top: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.badge {
  position: absolute;
  right: -10rpx;
  top: -22rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ef4444;
  color: #ffffff;
  font-size: 24rpx;
  line-height: 34rpx;
}

.order-label {
  font-size: 28rpx;
  line-height: 1.18;
}

.tool-title {
  margin-top: 70rpx;
  margin-bottom: 32rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  row-gap: 34rpx;
}

.tool-icon {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 14rpx;
  border: 4rpx solid #3a3a3a;
  border-radius: 8rpx;
  position: relative;
}

.tool-icon::after {
  content: "";
  position: absolute;
  right: -3rpx;
  bottom: -3rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 4rpx solid #f85f91;
  background: #ffffff;
}

.tool-label {
  color: #666666;
  font-size: 30rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: 132rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5e7eb;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #606060;
}

.tab.active {
  color: #fa5d90;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  position: relative;
}

.home-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 15rpx;
  width: 30rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 4rpx;
}

.home-icon::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 28rpx;
  height: 28rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.list-icon::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 26rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.list-icon::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 16rpx;
  width: 14rpx;
  height: 4rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor;
}

.shop-icon::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 15rpx;
  width: 34rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 0 0 6rpx 6rpx;
}

.shop-icon::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 26rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.mine-icon::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-icon::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 27rpx;
  width: 32rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 22rpx 22rpx 0 0;
  border-bottom: 0;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.auth-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.auth-sheet {
  width: 100%;
  padding: 58rpx 48rpx 42rpx;
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.auth-app-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.auth-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f5f5;
  color: #d2a600;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 72rpx;
  text-align: center;
}

.auth-app-name {
  color: #111111;
  font-size: 34rpx;
  font-weight: 800;
}

.auth-app-subtitle {
  margin-top: 12rpx;
  color: #111111;
  font-size: 38rpx;
  font-weight: 900;
}

.auth-profile-row {
  height: 118rpx;
  margin: 0 0 34rpx;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
}

.auth-avatar-button {
  width: 86rpx;
  height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: transparent;
  line-height: 1;
}

.auth-avatar-button::after {
  border: 0;
}

.auth-avatar {
  width: 86rpx;
  height: 86rpx;
  border-radius: 8rpx;
}

.auth-avatar-empty {
  background: #eeeeee;
  position: relative;
}

.auth-avatar-empty::before {
  content: "";
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #d0d0d0;
}

.auth-avatar-empty::after {
  content: "";
  position: absolute;
  left: 18rpx;
  bottom: 16rpx;
  width: 42rpx;
  height: 22rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #d0d0d0;
}

.auth-nickname {
  flex: 1;
  color: #111111;
  font-size: 36rpx;
}

.auth-check {
  width: 54rpx;
  color: #09a35c;
  font-size: 42rpx;
  font-weight: 800;
}

.auth-title {
  color: #111111;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.auth-text {
  margin-top: 30rpx;
  color: #222222;
  font-size: 32rpx;
  line-height: 1.85;
}

.auth-text text {
  color: #1976d2;
}

.auth-confirm {
  margin-top: 44rpx;
  height: 86rpx;
  border-radius: 999rpx;
  background: #06c160;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 86rpx;
}

.auth-confirm::after {
  border: 0;
}

.auth-cancel {
  height: 78rpx;
  margin-top: 18rpx;
  color: #333333;
  font-size: 32rpx;
  line-height: 78rpx;
  text-align: center;
}
