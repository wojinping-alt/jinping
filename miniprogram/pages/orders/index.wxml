<view class="orders-page">
  <view class="search-wrap">
    <view class="search-icon"></view>
    <input
      class="search-input"
      placeholder="搜索我的订单"
      value="{{keyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <scroll-view class="tab-scroll" scroll-x="true" show-scrollbar="{{false}}">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab-item {{activeTab == item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="selectTab"
      >
        {{item.label}}
        <view wx:if="{{item.badge > 0}}" class="tab-badge">{{item.badge}}</view>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{activeTab == 'review'}}" class="review-center-tabs">
    <view
      class="review-center-tab {{reviewSubTab == 'pending' ? 'active' : ''}}"
      data-key="pending"
      bindtap="selectReviewSubTab"
    >待评价({{reviewCounts.pending}})</view>
    <view
      class="review-center-tab {{reviewSubTab == 'evaluated' ? 'active' : ''}}"
      data-key="evaluated"
      bindtap="selectReviewSubTab"
    >已评价</view>
  </view>

  <view wx:if="{{activeTab == 'review' && reviewSubTab == 'pending'}}" class="review-tip">
    <view class="tip-icon">!</view>
    <view class="tip-text">此列表仅展示待评价订单，免费商品可前往课程页评价</view>
    <view class="tip-close">×</view>
  </view>

  <view wx:if="{{loading}}" class="state-card">加载中...</view>
  <view wx:elif="{{error}}" class="state-card error">{{error}}</view>
  <view wx:elif="{{filteredOrders.length == 0}}" class="empty">
    <view class="empty-icon"></view>
    <view class="empty-title">暂无相关订单</view>
    <view class="empty-desc">购买课程或服务后，订单会显示在这里。</view>
    <button class="home-btn" bindtap="goHome">去逛逛</button>
  </view>

  <view wx:else class="order-list">
    <view wx:for="{{filteredOrders}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="goDetail">
      <block wx:if="{{activeTab == 'review' && reviewSubTab == 'pending'}}">
        <view class="review-shop">字书</view>
        <view class="review-order-body">
          <image class="review-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <view class="review-order-info">
            <view class="review-title">{{item.title}}</view>
            <view class="review-subtitle">{{item.subtitle}}</view>
          </view>
          <view class="review-button" data-id="{{item.id}}" catchtap="reviewOrder">
            {{reviewSubTab == "evaluated" ? "查看" : "评价"}}
          </view>
        </view>
      </block>

      <block wx:elif="{{activeTab == 'review' && reviewSubTab == 'evaluated'}}">
        <view class="evaluated-review-card" data-id="{{item.id}}" catchtap="reviewOrder">
          <view class="evaluated-user-row">
            <image wx:if="{{item.reviewAvatar}}" class="evaluated-avatar" src="{{item.reviewAvatar}}" mode="aspectFill"></image>
            <view wx:else class="evaluated-avatar fallback">字</view>
            <view class="evaluated-user-main">
              <view class="evaluated-user-name">{{item.reviewUserName}}</view>
              <view class="evaluated-stars">
                <text
                  wx:for="{{item.reviewStars}}"
                  wx:for-item="star"
                  wx:key="*this"
                  class="evaluated-star {{item.reviewScore >= star ? 'active' : ''}}"
                >★</text>
              </view>
            </view>
            <view class="evaluated-more">⋮</view>
          </view>
          <view class="evaluated-content">{{item.reviewContent || "这个课程很有帮助"}}</view>
          <view class="evaluated-meta">{{item.reviewTimeText}} 广东省，</view>
          <view wx:if="{{item.appendContent || item.appendImages.length}}" class="evaluated-append">
            <view class="evaluated-append-title">{{item.appendDelayText}}</view>
            <view wx:if="{{item.appendContent}}" class="evaluated-append-content">{{item.appendContent}}</view>
            <view wx:if="{{item.appendImages.length}}" class="evaluated-append-images">
              <image
                wx:for="{{item.appendImages}}"
                wx:for-item="appendImage"
                wx:key="*this"
                class="evaluated-append-image"
                src="{{appendImage}}"
                mode="aspectFill"
              ></image>
            </view>
          </view>
          <view class="evaluated-product">
            <image class="evaluated-product-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view class="evaluated-product-info">
              <view class="evaluated-product-title">{{item.title}}</view>
              <view class="evaluated-product-subtitle">{{item.subtitle}}</view>
            </view>
          </view>
          <view class="evaluated-footer">
            <view class="useful">♡ 有用</view>
            <view wx:if="{{!item.appendContent && !item.appendImages.length}}" class="append-review-button" data-id="{{item.id}}" catchtap="appendReviewFromOrder">追评</view>
          </view>
        </view>
      </block>

      <block wx:else>
      <view class="order-head">
        <view class="shop-name">字书 <text>›</text></view>
        <view class="status {{item.status}}">{{item.statusLabel}}</view>
      </view>

      <view class="order-body">
        <image class="cover" src="{{item.coverImage}}" mode="aspectFill"></image>
        <view class="order-info">
          <view class="title">{{item.title}}</view>
          <view class="subtitle">{{item.subtitle}}</view>
          <view class="unit-price">¥ {{item.amountText}}</view>
          <view class="time">下单时间：{{item.createdAtText || "暂无"}}</view>
        </view>
        <view class="quantity">x{{item.quantity}}</view>
      </view>

      <view class="order-total">
        <view wx:if="{{item.status == 'pending'}}" class="remaining">
          剩余时间：<text>{{item.remainingText || "02时00分00秒"}}</text>
        </view>
        <text>{{item.status == "paid" ? "实付：" : "需付："}}</text>
        <text class="total-price">¥ {{item.status == "paid" ? item.amountText : item.amountText}}</text>
      </view>

      <view wx:if="{{item.status == 'paid'}}" class="order-actions">
        <view class="action-btn" catchtap="requestAfterSale">申请售后</view>
        <view class="action-btn primary" data-id="{{item.id}}" catchtap="reviewOrder">评价</view>
      </view>
      <view wx:elif="{{item.status == 'pending'}}" class="order-actions">
        <view
          class="action-btn"
          data-id="{{item.id}}"
          catchtap="cancelOrder"
        >{{canceling == item.id ? "取消中" : "取消"}}</view>
        <view class="action-btn primary" data-id="{{item.id}}" catchtap="payAgain">{{paying == item.id ? "支付中" : "立即付款"}}</view>
      </view>
      </block>
    </view>
    <view class="list-end">没有更多了~</view>
  </view>

  <view wx:if="{{showCancelConfirm}}" class="cancel-mask" catchtap="closeCancelConfirm">
    <view class="cancel-dialog" catchtap="noop">
      <view class="cancel-message">订单还未付款，确定要取消吗？</view>
      <view class="cancel-actions">
        <view class="cancel-left" catchtap="confirmCancelOrder">
          {{canceling == cancelTargetOrder.id ? "取消中" : "取消订单"}}
        </view>
        <view class="cancel-right" catchtap="closeCancelConfirm">再考虑下</view>
      </view>
    </view>
  </view>
</view>
