.owned-page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 150rpx;
  color: #2f2f2f;
}

.owned-tabs {
  height: 112rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  gap: 54rpx;
  white-space: nowrap;
  overflow-x: auto;
}

.owned-tab {
  position: relative;
  flex: 0 0 auto;
  color: #626262;
  font-size: 42rpx;
  font-weight: 500;
  line-height: 112rpx;
}

.owned-tab.active {
  color: #141414;
  font-size: 48rpx;
  font-weight: 900;
}

.owned-tab.active::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 18rpx;
  width: 68rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #f85f91;
}

.recent-link {
  height: 86rpx;
  color: #9a9a9a;
  font-size: 32rpx;
  text-align: center;
  line-height: 86rpx;
}

.state,
.empty-card {
  margin: 46rpx 32rpx;
  padding: 42rpx 30rpx;
  border-radius: 12rpx;
  background: #fafafa;
  color: #8b8b8b;
  font-size: 30rpx;
  text-align: center;
}

.error {
  color: #dc2626;
}

.empty-title {
  color: #333333;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 14rpx;
  color: #999999;
}

.empty-button {
  width: 260rpx;
  height: 72rpx;
  margin-top: 28rpx;
  border-radius: 999rpx;
  background: #f85f91;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 72rpx;
}

.empty-button::after {
  border: 0;
}

.owned-list {
  padding: 10rpx 32rpx 40rpx;
}

.owned-item {
  display: flex;
  gap: 24rpx;
  padding: 28rpx 0;
}

.cover-wrap {
  position: relative;
  flex: 0 0 270rpx;
  width: 270rpx;
  height: 150rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #eeeeee;
}

.owned-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.cover-tag {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 86rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.42);
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
}

.owned-info {
  flex: 1;
  min-width: 0;
}

.owned-title {
  color: #444444;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owned-line {
  margin-top: 16rpx;
  color: #989898;
  font-size: 32rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-button {
  position: fixed;
  right: 20rpx;
  bottom: 204rpx;
  z-index: 20;
  width: 136rpx;
  height: 132rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

.service-button::after {
  border: 0;
}

.service-bubble {
  position: fixed;
  right: 48rpx;
  bottom: 246rpx;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 26rpx rgba(0, 0, 0, 0.12);
}

.service-text {
  position: fixed;
  right: 20rpx;
  bottom: 204rpx;
  color: #666666;
  font-size: 30rpx;
}

.bottom-tabs {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  height: 132rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #e5e7eb;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #606060;
}

.tab.active {
  color: #fa5d90;
}

.tab-icon {
  width: 46rpx;
  height: 46rpx;
  position: relative;
}

.home-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 15rpx;
  width: 30rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-top: 0;
  border-radius: 4rpx;
}

.home-icon::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 28rpx;
  height: 28rpx;
  border-left: 4rpx solid currentColor;
  border-top: 4rpx solid currentColor;
  transform: rotate(45deg);
}

.list-icon::before {
  content: "";
  position: absolute;
  left: 11rpx;
  top: 5rpx;
  width: 26rpx;
  height: 36rpx;
  border: 4rpx solid currentColor;
  border-radius: 4rpx;
}

.list-icon::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 16rpx;
  width: 14rpx;
  height: 4rpx;
  background: currentColor;
  box-shadow: 0 10rpx 0 currentColor;
}

.shop-icon::before {
  content: "";
  position: absolute;
  left: 6rpx;
  top: 15rpx;
  width: 34rpx;
  height: 24rpx;
  border: 4rpx solid currentColor;
  border-radius: 0 0 6rpx 6rpx;
}

.shop-icon::after {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 26rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-bottom: 0;
  border-radius: 18rpx 18rpx 0 0;
}

.mine-icon::before {
  content: "";
  position: absolute;
  left: 15rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}

.mine-icon::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 27rpx;
  width: 32rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 22rpx 22rpx 0 0;
  border-bottom: 0;
}

.tab-text {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}
