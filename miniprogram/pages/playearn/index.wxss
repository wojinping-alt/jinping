.playearn-page {
  min-height: 100vh;
  padding-bottom: 138rpx;
  background: #f5f5f5;
}

.shop-top {
  height: 92rpx;
  padding: 0 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eeeeee;
}

.shop-left {
  display: flex;
  align-items: center;
  min-width: 0;
}

.shop-logo-img {
  width: 52rpx;
  height: 52rpx;
  display: block;
}

.shop-name {
  margin-left: 18rpx;
  color: #222222;
  font-size: 38rpx;
  font-weight: 900;
}

.shop-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.shop-action {
  width: 42rpx;
  height: 42rpx;
  position: relative;
}

.search-action {
  border: 5rpx solid #111111;
  border-radius: 50%;
  box-sizing: border-box;
}

.search-action::after {
  content: "";
  position: absolute;
  right: -9rpx;
  bottom: -5rpx;
  width: 18rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #111111;
  transform: rotate(45deg);
}

.share-action::before {
  content: "";
  position: absolute;
  left: 6rpx;
  bottom: 5rpx;
  width: 28rpx;
  height: 26rpx;
  border: 5rpx solid #111111;
  border-top: 0;
  border-radius: 4rpx;
}

.share-action::after {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 1rpx;
  width: 18rpx;
  height: 18rpx;
  border-top: 5rpx solid #111111;
  border-right: 5rpx solid #111111;
}

.user-action::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 3rpx;
  width: 18rpx;
  height: 18rpx;
  border: 5rpx solid #111111;
  border-radius: 50%;
}

.user-action::after {
  content: "";
  position: absolute;
  left: 4rpx;
  bottom: 1rpx;
  width: 34rpx;
  height: 20rpx;
  border: 5rpx solid #111111;
  border-bottom: 0;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
}

.shop-dot {
  color: #111111;
  font-size: 34rpx;
  line-height: 1;
  letter-spacing: 4rpx;
}

.hero-wrap {
  position: relative;
  padding: 26rpx 0 0;
  background: #efefef;
  display: flex;
  justify-content: center;
}

.product-hero {
  width: 560rpx;
  max-width: 560rpx;
  display: block;
  background: #ffffff;
}

.goods-tag {
  position: absolute;
  right: 20rpx;
  bottom: 24rpx;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(80, 80, 80, 0.62);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.product-info {
  padding: 34rpx 34rpx 36rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column-reverse;
}

.product-title {
  margin-top: 22rpx;
  color: #262626;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.35;
}

.product-subtitle {
  display: none;
  margin-top: 14rpx;
  color: #8b8b8b;
  font-size: 28rpx;
  line-height: 1.5;
}

.price-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price {
  color: #f05a2a;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.sold {
  color: #b3b3b3;
  font-size: 32rpx;
}

.sku-row {
  margin-top: 18rpx;
  height: 104rpx;
  padding: 0 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8b8b8b;
  border-bottom: 1rpx solid #eeeeee;
}

.sku-label {
  font-size: 34rpx;
}

.sku-label text {
  margin-left: 18rpx;
  color: #333333;
  font-weight: 800;
}

.sku-value {
  color: #a8a8a8;
  font-size: 34rpx;
}

.shop-entry {
  margin-top: 18rpx;
  height: 122rpx;
  padding: 0 34rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.visit-btn {
  height: 66rpx;
  padding: 0 28rpx;
  border: 2rpx solid #f85f91;
  border-radius: 10rpx;
  color: #f85f91;
  line-height: 66rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.tab-row {
  height: 116rpx;
  padding-left: 34rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-end;
  border-bottom: 0;
}

.tab {
  position: relative;
  width: auto;
  height: 92rpx;
  line-height: 68rpx;
  text-align: left;
  color: #222222;
  font-size: 42rpx;
  font-weight: 900;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 52rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #f85f91;
  transform: translateX(-50%);
}

.detail-images {
  padding-top: 0;
  background: #efefef;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.detail-image {
  width: 650rpx;
  max-width: 650rpx;
  display: block;
}

.service-bubble {
  position: fixed;
  right: 48rpx;
  bottom: 188rpx;
  z-index: 20;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 6rpx 26rpx rgba(0, 0, 0, 0.12);
}

.service-bubble::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 24rpx;
  width: 42rpx;
  height: 34rpx;
  border: 6rpx solid #333333;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  border-bottom: 0;
}

.service-bubble::after {
  content: "";
  position: absolute;
  right: 18rpx;
  top: 52rpx;
  width: 14rpx;
  height: 18rpx;
  border-right: 6rpx solid #333333;
  border-bottom: 6rpx solid #333333;
  border-bottom-right-radius: 10rpx;
}

.service-text {
  position: fixed;
  right: 20rpx;
  bottom: 148rpx;
  z-index: 20;
  color: #666666;
  font-size: 30rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  min-height: 118rpx;
  padding: 14rpx 26rpx env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.bar-item {
  width: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #555555;
}

.bar-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.service-icon::before {
  content: "";
  position: absolute;
  left: 5rpx;
  top: 8rpx;
  width: 34rpx;
  height: 26rpx;
  border: 5rpx solid #333333;
  border-top-left-radius: 18rpx;
  border-top-right-radius: 18rpx;
  border-bottom: 0;
}

.bar-text {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.buy-button {
  flex: 1;
  height: 82rpx;
  margin: 0;
  border: 0;
  border-radius: 12rpx;
  background: #f85f91;
  color: #ffffff;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.buy-button::after {
  border: 0;
}

.sku-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.66);
  display: flex;
  align-items: flex-end;
}

.sku-panel {
  width: 100%;
  min-height: 690rpx;
  padding: 32rpx 30rpx 54rpx;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.sku-head {
  position: relative;
  display: flex;
  align-items: flex-start;
}

.sku-thumb {
  width: 152rpx;
  height: 152rpx;
  display: block;
  background: #f5f5f5;
}

.sku-summary {
  flex: 1;
  margin-left: 32rpx;
}

.sku-price {
  color: #f05a2a;
  font-size: 64rpx;
  font-weight: 500;
  line-height: 1;
}

.sku-price text {
  margin-left: 8rpx;
  font-size: 30rpx;
}

.sku-stock,
.sku-chosen {
  margin-top: 18rpx;
  color: #8b8b8b;
  font-size: 34rpx;
}

.sku-close {
  position: absolute;
  right: 4rpx;
  top: -8rpx;
  color: #c9c9c9;
  font-size: 74rpx;
  line-height: 1;
}

.sku-divider {
  margin-top: 32rpx;
  height: 1rpx;
  background: #eeeeee;
}

.sku-title {
  margin-top: 30rpx;
  color: #222222;
  font-size: 40rpx;
  font-weight: 900;
}

.type-list {
  margin-top: 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx 24rpx;
}

.type-pill {
  min-width: 108rpx;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f7f7f7;
  color: #333333;
  text-align: center;
  line-height: 52rpx;
  font-size: 32rpx;
  box-sizing: border-box;
}

.type-pill.selected {
  background: #fff0f5;
  color: #f85f91;
}

.quantity-row {
  margin-top: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-title {
  color: #222222;
  font-size: 40rpx;
  font-weight: 900;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn,
.step-value {
  width: 72rpx;
  height: 52rpx;
  text-align: center;
  line-height: 52rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.step-btn.muted {
  color: #cfcfcf;
}

.step-value {
  background: #f5f5f5;
  color: #333333;
  font-weight: 500;
}

.confirm-button {
  margin-top: 118rpx;
  width: 100%;
  height: 86rpx;
  border: 0;
  border-radius: 999rpx;
  background: #f85f91;
  color: #ffffff;
  line-height: 86rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.confirm-button::after {
  border: 0;
}
