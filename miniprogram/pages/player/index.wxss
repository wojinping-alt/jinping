.player-page {
  padding-left: 0;
  padding-right: 0;
}

.title {
  padding: 0 32rpx 24rpx;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.4;
}

.state {
  margin: 0 32rpx;
  padding: 40rpx;
  color: #6b7280;
}

.error {
  color: #dc2626;
}

.player-wrap {
  position: relative;
}

.video {
  width: 100%;
  height: 430rpx;
  background: #000000;
}

.watermark {
  position: absolute;
  top: 92rpx;
  right: 24rpx;
  z-index: 2;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.28);
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.expire {
  padding: 24rpx 32rpx;
  font-size: 25rpx;
}
