.review-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #ffffff;
  color: #2f2f2f;
}

.detail-page {
  background: #f7f7f7;
}

.product-row {
  min-height: 150rpx;
  padding: 34rpx 34rpx 30rpx;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  gap: 24rpx;
  box-sizing: border-box;
}

.detail-page .product-row {
  background: #ffffff;
}

.product-cover {
  width: 110rpx;
  height: 86rpx;
  flex: none;
  background: #f2f2f2;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-title {
  color: #333333;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-subtitle {
  margin-top: 8rpx;
  color: #9a9a9a;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  margin-top: 20rpx;
  color: #f06423;
  font-size: 42rpx;
  font-weight: 500;
}

.review-detail-card {
  margin-top: 20rpx;
  padding: 38rpx 34rpx 54rpx;
  background: #ffffff;
  position: relative;
}

.review-user-row {
  display: flex;
  align-items: flex-start;
  position: relative;
}

.review-avatar {
  width: 82rpx;
  height: 82rpx;
  flex: none;
  border-radius: 50%;
  background: #eeeeee;
}

.review-avatar.fallback {
  color: #d5a500;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 82rpx;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.review-user-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.review-user-name {
  color: #333333;
  font-size: 38rpx;
  font-weight: 800;
}

.review-star-line {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  min-width: 0;
}

.detail-star {
  color: #eeeeee;
  font-size: 28rpx;
}

.detail-star.active {
  color: #ff8a1f;
}

.review-course-name {
  margin-left: 12rpx;
  color: #9a9a9a;
  font-size: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.more-dot {
  width: 54rpx;
  color: #999999;
  font-size: 50rpx;
  line-height: 54rpx;
  text-align: right;
}

.review-menu {
  position: absolute;
  right: 0;
  top: 58rpx;
  z-index: 5;
  width: 198rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
}

.review-menu view {
  height: 90rpx;
  border-bottom: 1rpx solid #eeeeee;
  color: #333333;
  font-size: 34rpx;
  line-height: 90rpx;
  text-align: center;
}

.review-content {
  margin-top: 34rpx;
  color: #333333;
  font-size: 44rpx;
  line-height: 1.45;
}

.detail-images {
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.detail-image {
  width: 170rpx;
  height: 170rpx;
  border-radius: 8rpx;
  background: #eeeeee;
}

.review-meta {
  margin-top: 54rpx;
  color: #9a9a9a;
  font-size: 34rpx;
}

.useful-row {
  margin-top: 36rpx;
  color: #333333;
  font-size: 36rpx;
  text-align: right;
}

.append-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 22rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  display: flex;
  justify-content: flex-end;
}

.append-btn {
  width: 170rpx;
  height: 66rpx;
  border: 3rpx solid #2f80ed;
  border-radius: 999rpx;
  color: #2f80ed;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
  box-sizing: border-box;
}

.score-row {
  height: 184rpx;
  padding: 0 34rpx;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  align-items: center;
}

.score-label {
  margin-right: 24rpx;
  color: #333333;
  font-size: 44rpx;
  font-weight: 900;
}

.stars {
  display: flex;
  gap: 18rpx;
}

.star {
  color: #eeeeee;
  font-size: 54rpx;
  line-height: 1;
}

.star.active {
  color: #f7c948;
}

.content-input {
  width: 100%;
  height: 246rpx;
  padding: 44rpx 34rpx;
  color: #333333;
  font-size: 36rpx;
  line-height: 1.7;
  border-bottom: 1rpx solid #eeeeee;
  box-sizing: border-box;
}

.image-row {
  min-height: 210rpx;
  padding: 36rpx 34rpx 28rpx;
  border-bottom: 1rpx solid #eeeeee;
  display: flex;
  gap: 18rpx;
  flex-wrap: wrap;
  box-sizing: border-box;
}

.upload-box {
  width: 188rpx;
  height: 188rpx;
  border-radius: 12rpx;
  background: #f4f4f4;
  color: #b0b0b0;
  font-size: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.upload-image {
  width: 188rpx;
  height: 188rpx;
}

.image-icon {
  width: 50rpx;
  height: 42rpx;
  margin-bottom: 18rpx;
  border: 5rpx solid #aaaaaa;
  border-radius: 8rpx;
  position: relative;
}

.image-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  bottom: 6rpx;
  width: 28rpx;
  height: 18rpx;
  border-left: 5rpx solid #aaaaaa;
  border-bottom: 5rpx solid #aaaaaa;
  transform: skewX(-24deg);
}

.remove-image {
  position: absolute;
  right: 0;
  top: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 0 0 0 12rpx;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  font-size: 34rpx;
  line-height: 42rpx;
  text-align: center;
}

.anonymous-row {
  min-height: 130rpx;
  padding: 28rpx 34rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border: 3rpx solid #d8d8d8;
  border-radius: 50%;
  flex: none;
}

.checkbox.checked {
  border-color: #2b7df1;
  background: #2b7df1;
  box-shadow: inset 0 0 0 10rpx #ffffff;
}

.anonymous-title {
  width: 150rpx;
  color: #333333;
  font-size: 38rpx;
  font-weight: 500;
}

.anonymous-desc {
  flex: 1;
  color: #9a9a9a;
  font-size: 30rpx;
  line-height: 1.4;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 34rpx calc(22rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.submit-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: #1d7cf2;
  color: #ffffff;
  font-size: 34rpx;
  line-height: 88rpx;
}

.submit-btn::after {
  border: 0;
}
